
<Window x:Class="Conflux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflux" Height="820" Width="1440"
        MinHeight="600" MinWidth="1000"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource PrimaryText}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBackground}"
                Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="5">
                    <TextBlock Text="LOCAL WORKSPACE"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="10" Margin="3"/>
                    <TextBlock Text="Your AI team"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Provider routing enabled"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="11"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="CONFLUX"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="8,8,8,26"/>

                    <Button Content="＋  New task"
                            Click="NewTask_Click"
                            HorizontalContentAlignment="Left"/>

                    <Button Content="◈  Workspace"
                            Click="Workspace_Click"
                            HorizontalContentAlignment="Left"/>

                    <Button Content="▤  Conversations"
                            Click="Conversations_Click"
                            HorizontalContentAlignment="Left"/>

                    <Button Content="◇  AI providers"
                            Click="Settings_Click"
                            HorizontalContentAlignment="Left"/>

                    <Button Content="⚙  Settings"
                            Click="AppSettings_Click"
                            HorizontalContentAlignment="Left"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CENTER AREA -->
        <Grid Grid.Column="1" Margin="20">

            <!-- WORKSPACE / CHAT -->
            <Grid x:Name="ChatView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,0,4,14">
                    <StackPanel>
                        <TextBlock Text="AI Workspace"
                                   FontSize="23"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Your models. Your rules."
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ComboBox x:Name="TaskTypeBox"
                              Width="140"
                              Height="36"
                              SelectedIndex="0"
                              SelectionChanged="TaskType_Changed"
                              DockPanel.Dock="Right"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="General"/>
                        <ComboBoxItem Content="Coding"/>
                        <ComboBoxItem Content="Images"/>
                        <ComboBoxItem Content="Writing"/>
                    </ComboBox>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatMessages"
                                Margin="0,8,8,20">
                        <Border Background="{StaticResource CardBackground}"
                                CornerRadius="12"
                                Padding="18"
                                Margin="4,4,4,12">
                            <StackPanel>
                                <TextBlock Text="Welcome to Conflux"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource SecondaryText}"
                                           Text="Choose a task type, configure your AI providers, and send your first request. Your primary provider and backup are selected automatically."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="14"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PromptBox"
                                 MinHeight="58"
                                 MaxHeight="150"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="5"
                                 KeyDown="PromptBox_KeyDown"
                                 ToolTip="Describe what you want your AI team to do"/>

                        <Button Grid.Column="1"
                                Content="Send  ➤"
                                Padding="16,12"
                                VerticalAlignment="Bottom"
                                Click="Send_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- CONVERSATIONS -->
            <Grid x:Name="ConversationsView"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,4,18">
                    <TextBlock Text="Conversations"
                               FontSize="26"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Revisit chats from this app session."
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="3,0,3,10">
                    <TextBlock Text="Recent conversations"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="＋ New chat"
                            Click="NewTask_Click"
                            DockPanel.Dock="Right"/>
                </DockPanel>

                <ListBox x:Name="ConversationList"
                         Grid.Row="2"
                         Background="{StaticResource PanelBackground}"
                         Foreground="{StaticResource PrimaryText}"
                         BorderThickness="0"
                         SelectionChanged="ConversationList_SelectionChanged"
                         DisplayMemberPath="Title"
                         Padding="5"/>
            </Grid>

            <!-- AI PROVIDERS AND ROUTING -->
            <ScrollViewer x:Name="SettingsView"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="AI Providers"
                               FontSize="26"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Configure connections and task routing."
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,6,0,20"/>

                    <!-- CHATGPT ACCOUNT CONNECTION -->
                    <Border Background="{StaticResource CardBackground}"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="ChatGPT account"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Connect your own ChatGPT account using OpenAI's browser sign-in flow. Credentials are stored locally for your Windows user."
                                       Foreground="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12"/>

                            <Border Background="{StaticResource PanelBackground}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION STATUS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryText}"/>

                                    <TextBlock x:Name="ChatGptStatusLabel"
                                               Text="Checking connection..."
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>

                                    <TextBlock x:Name="ChatGptAccountLabel"
                                               Text=""
                                               Foreground="{StaticResource SecondaryText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <WrapPanel>
                                <Button x:Name="ConnectChatGptButton"
                                        Content="Continue with ChatGPT"
                                        Click="ConnectChatGpt_Click"
                                        Padding="12,8"
                                        Margin="0,0,8,6"/>

                                <Button x:Name="DisconnectChatGptButton"
                                        Content="Disconnect"
                                        Click="DisconnectChatGpt_Click"
                                        Padding="12,8"
                                        Margin="0,0,8,6"
                                        IsEnabled="False"/>
                            </WrapPanel>

                            <TextBlock Text="Sign-in permission and account eligibility determine whether ChatGPT-plan usage is available. Connecting here does not yet change the provider used by chat."
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PROVIDERS"
                               FontWeight="SemiBold"
                               Margin="3,8"/>

                    <ListBox x:Name="ProviderList"
                             Height="120"
                             Background="{StaticResource PanelBackground}"
                             Foreground="{StaticResource PrimaryText}"
                             SelectionChanged="ProviderList_Changed"/>

                    <TextBlock Text="Provider name"/>
                    <TextBox x:Name="ProviderNameBox"/>

                    <TextBlock Text="API base URL"/>
                    <TextBox x:Name="ProviderUrlBox"/>

                    <TextBlock Text="Model identifier"/>
                    <TextBox x:Name="ProviderModelBox"/>

                    <TextBlock Text="API key"/>
                    <PasswordBox x:Name="ProviderKeyBox"
                                 Background="#292B33"
                                 Foreground="White"
                                 BorderBrush="#41434F"
                                 Padding="9"
                                 Margin="3"/>

                    <CheckBox x:Name="ProviderEnabledBox"
                              Content="Provider enabled"
                              Margin="6,8"
                              IsChecked="True"/>

                    <WrapPanel Margin="0,8,0,18">
                        <Button Content="＋ Add provider"
                                Click="AddProvider_Click"/>
                        <Button Content="Save provider"
                                Click="SaveProvider_Click"/>
                        <Button Content="Remove provider"
                                Click="RemoveProvider_Click"/>
                    </WrapPanel>

                    <Separator Background="#41434F"
                               Margin="0,8,0,18"/>

                    <TextBlock Text="TASK ROUTING"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="3,8"/>

                    <TextBlock Text="Task type"/>
                    <ComboBox x:Name="RouteTaskBox"
                              SelectionChanged="RouteTask_Changed">
                        <ComboBoxItem Content="General"/>
                        <ComboBoxItem Content="Coding"/>
                        <ComboBoxItem Content="Images"/>
                        <ComboBoxItem Content="Writing"/>
                    </ComboBox>

                    <TextBlock Text="Primary AI"/>
                    <ComboBox x:Name="PrimaryProviderBox"/>

                    <TextBlock Text="Secondary AI / fallback"/>
                    <ComboBox x:Name="SecondaryProviderBox"/>

                    <CheckBox x:Name="ReviewBox"
                              Content="Ask secondary AI to review the answer"
                              Margin="6,10"/>

                    <Button Content="Save routing settings"
                            Click="SaveRoute_Click"
                            HorizontalAlignment="Left"
                            Margin="3,10"/>

                    <Button Content="← Back to workspace"
                            Click="Workspace_Click"
                            HorizontalAlignment="Left"
                            Margin="3,18"/>
                </StackPanel>
            </ScrollViewer>

            <!-- GENERAL SETTINGS -->
            <ScrollViewer x:Name="AppSettingsView"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="Settings"
                               FontSize="26"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Application preferences and controls."
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,6,0,22"/>

                    <Border Background="{StaticResource CardBackground}"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AI collaboration"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <CheckBox x:Name="GeneralReviewBox"
                                      Content="Enable independent AI review"
                                      Margin="3,6"
                                      Checked="GeneralReview_Changed"
                                      Unchecked="GeneralReview_Changed"/>

                            <TextBlock Text="When enabled, the secondary provider can review the primary provider's response for supported routes."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="3,6,3,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Provider configuration"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Add your AI providers, configure model identifiers, and choose primary and fallback routes."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="3,4,3,10"/>

                            <Button Content="Configure AI providers →"
                                    Click="Settings_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Conversation history"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Conversation history is currently kept for this app session. Persistent storage will be added in a later step."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="← Back to workspace"
                            Click="Workspace_Click"
                            HorizontalAlignment="Left"
                            Margin="3,18"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- RIGHT SIDEBAR -->
        <Border Grid.Column="2"
                Background="{StaticResource PanelBackground}"
                Padding="15">
            <StackPanel>
                <TextBlock Text="AI CONTROL CENTER"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryText}"
                           Margin="2,8,2,18"/>

                <TextBlock Text="Active task"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="ActiveTaskLabel"
                           Text="General"
                           Foreground="{StaticResource SecondaryText}"
                           Margin="2,5,2,18"/>

                <TextBlock Text="Primary provider"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PrimaryStatusLabel"
                           Text="Not configured"
                           Foreground="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="2,5,2,16"/>

                <TextBlock Text="Backup provider"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="SecondaryStatusLabel"
                           Text="No backup selected"
                           Foreground="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="2,5,2,16"/>

                <Separator Background="#41434F"
                           Margin="0,8,0,14"/>

                <TextBlock Text="COLLABORATION"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryText}"
                           Margin="2,0,2,10"/>

                <CheckBox x:Name="ReviewQuickBox"
                          Content="Independent review"
                          Margin="3,5"
                          Checked="ReviewQuick_Changed"
                          Unchecked="ReviewQuick_Changed"/>

                <TextBlock Text="The secondary AI reviews the primary response when enabled."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="11"
                           Margin="3,6,3,18"/>

                <Button Content="Configure providers →"
                        Click="Settings_Click"
                        HorizontalContentAlignment="Center"/>

                <TextBlock x:Name="StatusLabel"
                           Text="Ready"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"
                           Margin="3,20,3,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>