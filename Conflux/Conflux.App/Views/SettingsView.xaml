
<UserControl x:Class="Conflux.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181A20">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,12" />

            <TextBlock Text="Provider and application settings will appear here."
                       FontSize="14"
                       Foreground="#B8BBC5"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>